+"""Exact one-token prompt attention for teacher-forced evaluation."""
+def attention_wrapper(q_unpad,k_unpad,v_unpad,cu_seqlens_q,cu_seqlens_k,max_seqlen_q,max_seqlen_k,dropout_p=0.0,causal=True,head_mask_type=None,streaming_info=None):
+    assert max_seqlen_q==max_seqlen_k==1 and dropout_p==0 and causal
+    assert head_mask_type is None and streaming_info is None
+    assert q_unpad.shape==k_unpad.shape==v_unpad.shape
+    # A single causal position has attention probability exactly one.
+    return v_unpad.clone()
